# Server-only values. Never place these in public/ or commit filled-in secrets.
# Preferred: private gateway provisioned in Supabase Edge Functions.
SUPABASE_GATEWAY_URL=
SUPABASE_GATEWAY_SECRET=
# Alternative: direct Supabase access with a server-side secret key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SESSION_SECRET=
# Set to the final HTTPS website URL (without a trailing slash).
APP_ORIGIN=
# Optional local preview only; never enable in production.
# DEVELOPMENT_STORE=memory
