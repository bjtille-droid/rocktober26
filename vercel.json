{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/arcade",
      "destination": "/arcade.html"
    },
    {
      "source": "/roll-call",
      "destination": "/roll-call.html"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api/community",
      "destination": "/api/index?route=community"
    },
    {
      "source": "/api/costumes",
      "destination": "/api/index?route=costumes"
    },
    {
      "source": "/api/runs/start",
      "destination": "/api/index?route=runs/start"
    },
    {
      "source": "/api/runs/finish",
      "destination": "/api/index?route=runs/finish"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "public/game-core.js"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "trailingSlash": false
}
